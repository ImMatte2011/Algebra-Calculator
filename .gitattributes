# Normalize line endings to LF on commit for all text files.
# On checkout, Windows gets CRLF only for files that explicitly need it.
* text=auto eol=lf

# --- Source code: always LF ---
*.py        text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.properties text eol=lf

# --- Documentation: always LF ---
*.md        text eol=lf
*.txt       text eol=lf

# --- Windows-specific: CRLF ---
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew.bat text eol=crlf

# --- Binary: no normalization ---
*.jar       binary
*.apk       binary
*.keystore  binary
*.jks       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary