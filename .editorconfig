root = true

# --- Defaults for all files ---
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# --- Python ---
[*.py]
indent_size = 4
max_line_length = 100

# --- Kotlin / Gradle ---
[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# --- YAML / GitHub Actions ---
[*.{yml,yaml}]
indent_size = 2

# --- JSON ---
[*.json]
indent_size = 2

# --- TOML (Gradle version catalog) ---
[*.toml]
indent_size = 2

# --- Markdown: keep trailing spaces (two spaces = line break in MD) ---
[*.md]
trim_trailing_whitespace = false

# --- Makefiles need real tabs ---
[Makefile]
indent_style = tab

# --- Windows batch: CRLF ---
[*.{bat,cmd}]
end_of_line = crlf